{
  "rules": {
    "orders": {
      ".indexOn": ["userId", "status"],
      ".read": "auth != null && (auth.token.role === 'staff' || (query.orderByChild === 'userId' && query.equalTo === auth.uid))",
      "$orderId": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || auth.token.role === 'staff')",
        ".write": false
      }
    }
  }
}
