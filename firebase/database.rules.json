{
  "rules": {
    "categories": {
      ".read": "auth != null",
      ".write": false
    },
    "foods": {
      ".read": "auth != null",
      ".write": false
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['fullName', 'studentId', 'email'])"
      }
    },
    "orders": {
      ".indexOn": ["userId", "status"],
      ".read": "auth != null && (auth.token.role === 'staff' || (query.orderByChild === 'userId' && query.equalTo === auth.uid))",
      "$orderId": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || auth.token.role === 'staff')",
        ".write": false
      }
    }
  }
}
